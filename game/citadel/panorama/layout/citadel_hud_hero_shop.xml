						</Panel>
						<Panel class="TargetProgressBarOuter">
							<Panel id="TargetProgressBarInner" />
						</Panel>
						<Label id="TargetProgressText" text="0 / 0 душ" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>

		<!-- Floating Return Button (Visible only when in Vanilla Shop mode) -->
		<Button id="ReturnToRouletteFloatBtn" onactivate="ItemRoulette.ToggleVanillaShop();">
			<Label class="ReturnToRouletteFloatLabel" text="← ВЕРНУТЬСЯ К РУЛЕТКЕ" />
		</Button>

		<Panel id="Outline" hittest="false" />
	</CitadelHudHeroShop>
</root>
