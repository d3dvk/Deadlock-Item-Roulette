					</Panel>
				</Panel>
				<Button id="ToggleVanillaShopBtn" class="ToggleVanillaBtn">
					<Label id="ToggleVanillaShopLabel" class="ToggleVanillaLabel" text="ОБЫЧНЫЙ МАГАЗИН" />
				</Button>
			</Panel>

			<!-- Roulette Reel Area -->
			<Panel class="RouletteMainArea">
				<Panel class="RouletteViewportContainer">
					<Panel class="CenterPointer" />
					<Panel class="PointerArrowTop" />
					<Panel class="PointerArrowBottom" />
					<Panel id="RouletteReel" />
				</Panel>

				<!-- Controls -->
				<Panel class="RouletteControls">
					<Button id="SpinButton">
						<Label class="SpinButtonLabel" text="КРУТИТЬ РУЛЕТКУ" />
					</Button>
					<Label id="RouletteStatusLabel" text="ГОТОВО К ПРОКРУТКЕ" />
				</Panel>

				<!-- Current Target Goal -->
				<Panel id="TargetItemContainer" class="NoTarget">
					<Panel id="TargetItemIcon" />
					<Panel class="TargetDetails">
						<Panel class="TargetTopRow">
							<Label id="TargetItemName" text="Нет активной цели" />
